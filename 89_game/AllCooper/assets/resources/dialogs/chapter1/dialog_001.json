{
  "id": "dialog_001",
  "name": "初次相遇",
  "characters": ["char_001_roland", "char_002_wei"],
  "startLineId": "line_001",
  "backgroundId": "bg_cave",
  "bgmId": "bgm_mystery",
  "lines": [
    {
      "id": "line_001",
      "speakerId": "char_001_roland",
      "speakerName": "罗兰",
      "text": "...这里是...什么地方？",
      "speakerEmotion": "default",
      "listenerId": "char_002_wei",
      "listenerEmotion": "default",
      "nextDialogId": "line_002"
    },
    {
      "id": "line_002",
      "speakerId": "char_002_wei",
      "speakerName": "薇",
      "text": "你终于醒了。",
      "speakerEmotion": "default",
      "listenerId": "char_001_roland",
      "listenerEmotion": "surprised",
      "nextDialogId": "line_003"
    },
    {
      "id": "line_003",
      "speakerId": "char_001_roland",
      "speakerName": "罗兰",
      "text": "你...你是谁？我为什么会在这里？",
      "speakerEmotion": "surprised",
      "nextDialogId": "line_004"
    },
    {
      "id": "line_004",
      "speakerId": "char_002_wei",
      "speakerName": "薇",
      "text": "我叫薇。你在废墟里昏迷，是我把你救回来的。",
      "speakerEmotion": "default",
      "nextDialogId": "line_005"
    },
    {
      "id": "line_005",
      "speakerId": "char_001_roland",
      "speakerName": "罗兰",
      "text": "废墟...？我什么都不记得了...",
      "speakerEmotion": "thinking",
      "nextDialogId": "line_006"
    },
    {
      "id": "line_006",
      "speakerId": "char_002_wei",
      "speakerName": "薇",
      "text": "先别想那么多了。这里不安全，我们得赶紧离开。",
      "speakerEmotion": "determined",
      "nextDialogId": "line_007"
    },
    {
      "id": "line_007",
      "speakerId": "char_001_roland",
      "speakerName": "罗兰",
      "text": "好，我跟你走。",
      "speakerEmotion": "determined",
      "nextDialogId": null
    }
  ]
}
